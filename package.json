{
  "name": "guardrail-api",
  "version": "1.0.0",
  "description": "API Security CLI for static OpenAPI analysis and dynamic security testing",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "guardrail-api": "./bin/guardrail.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "tsx src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "openapi",
    "swagger",
    "security",
    "api-security",
    "cli",
    "dast",
    "sast",
    "linter"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@apidevtools/swagger-parser": "^10.1.1",
    "axios": "^1.7.9",
    "cli-table3": "^0.6.5",
    "commander": "^13.1.0",
    "openapi-types": "^12.1.3",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^5.0.3"
  }
}
